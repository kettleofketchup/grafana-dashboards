# /etc/grafana-alloy/env — read by the grafana-alloy systemd service.
# Permissions: 0600 grafana-alloy:grafana-alloy.
# `just alloy::setup <kube-context>` writes this from a cluster Secret, or copy
# this file and fill it in by hand.

# Basic-auth credentials for your Prometheus remote_write + Loki push endpoints.
PROM_USER=changeme
PROM_PASS=changeme
LOKI_USER=changeme
LOKI_PASS=changeme

# Ingest endpoints. Optional — if unset, the config falls back to the
# kettle cluster defaults (prometheus-ingest/loki-ingest.home.kettle.sh).
# Point these at YOUR Prometheus (remote_write) and Loki (push) URLs.
PROM_URL=https://prometheus.example.com/api/v1/write
LOKI_URL=https://loki.example.com/loki/api/v1/push

# Run experimental Alloy components (process-exporter, cadvisor, journal).
CUSTOM_ARGS=--stability.level=experimental
